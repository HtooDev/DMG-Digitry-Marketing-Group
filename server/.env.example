# Prisma 7 / MariaDB driver adapter
# Provide EITHER a single DATABASE_URL (preferred), OR the separate DB_* vars.
DATABASE_URL="mysql://root:Manuel%402086@127.0.0.1:3306/DMG"
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_USER="root"
# DB_PASSWORD="..."
# DB_NAME="DMG"

# Storage
# STORAGE_DRIVER=disk  → local disk (development, default)
# STORAGE_DRIVER=spaces → DigitalOcean Spaces (production)
STORAGE_DRIVER="disk"
UPLOAD_DIR="uploads"
PUBLIC_BASE_URL="http://localhost:5000" # used to build disk file URLs

# DigitalOcean Spaces (S3-compatible) — only needed when STORAGE_DRIVER=spaces
SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
SPACES_BUCKET="my-bucket"
SPACES_REGION="fra1"
SPACES_ACCESS_KEY_ID="your_access_key"
SPACES_SECRET_ACCESS_KEY="your_secret_key"
SPACES_CDN_URL="https://my-bucket.fra1.cdn.digitaloceanspaces.com" # optional public URL

# YouTube Data API
YOUTUBE_API_KEY="your_youtube_api_key"
YOUTUBE_CHANNEL_ID="your_channel_id"

# App
PORT=5000
CLIENT_ORIGIN="http://localhost:3000"

# Image optimization on upload (resolution is always preserved)
IMAGE_QUALITY=80 # JPEG/WebP quality 1-100; transparent PNGs are converted to WebP

# Auth (JWT for admin panel)
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"
