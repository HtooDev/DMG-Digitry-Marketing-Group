// DMG Database Schema — Marketer/agency site
// 14 tables grouped by: Catalog, Works, Visual branding, Blogs/vlogs, People, Admin

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// CATALOG
// ============================================================

// Services sold on Home (social, video, content, media buying, strategy)
model Service {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  title       String
  description String  @db.Text
  icon        String?
  packageUrl  String? // hosted PDF showing packages/pricing
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectService[]

  @@index([isActive, sortOrder])
}

// Industries stay on clients / Works only (real estate, FMCG, ...)
model Industry {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
}

// ============================================================
// WORKS
// ============================================================

model Client {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  logoUrl     String? // hosted on DO Spaces

  industryId Int?
  industry   Industry? @relation(fields: [industryId], references: [id])

  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  brandings Branding[]

  @@index([industryId])
  @@index([isActive])
}

// A campaign — can be linked to multiple services
model Project {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  slug        String  @unique
  summary     String? @db.Text
  description String? @db.Text
  year        Int?
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services ProjectService[]
  images   ProjectImage[]

  @@index([clientId])
  @@index([isPublished])
}

// Many-to-many join between projects and services
model ProjectService {
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
}

// A photo for a project; a "case study" is a photo that shows data.
model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  url         String // hosted on DO Spaces
  alt         String?
  caption     String?
  isPrimary   Boolean @default(false) // card = true, only one per project
  sortOrder   Int     @default(0) // sequence 1, 2, 3...
  isCaseStudy Boolean @default(false) // true = this photo shows data

  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
  @@index([projectId, isPrimary])
}

// ============================================================
// VISUAL BRANDING
// ============================================================

// Identity look: logo, colors, stationery, mockups
model Branding {
  id       Int     @id @default(autoincrement())
  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name        String
  slug        String  @unique
  description String? @db.Text

  // brand colors for identity
  primaryColor   String?
  secondaryColor String?
  accentColor    String?

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images BrandingImage[]

  @@index([clientId])
  @@index([isPublished])
}

// Images for a visual branding set (logo, colors, stationery, mockups)
model BrandingImage {
  id         Int      @id @default(autoincrement())
  brandingId Int
  branding   Branding @relation(fields: [brandingId], references: [id], onDelete: Cascade)

  url       String // hosted on DO Spaces
  alt       String?
  isPrimary Boolean @default(false) // card = true, only one per branding
  sortOrder Int     @default(0) // sequence 1, 2, 3...

  createdAt DateTime @default(now())

  @@index([brandingId, sortOrder])
  @@index([brandingId, isPrimary])
}

// ============================================================
// BLOGS / VLOGS
// ============================================================

// type: "blog" (article) or "vlog" (video)
model Post {
  id          Int       @id @default(autoincrement())
  type        PostType  @default(blog)
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String?   @db.Text // article body for blog
  videoUrl    String? // YouTube URL/id when type = vlog
  youtubeId   String? // extracted YouTube id (for embedding)
  publishedAt DateTime?
  isPublished Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images PostImage[]

  @@index([type, isPublished])
  @@index([publishedAt])
}

model PostImage {
  id     Int  @id @default(autoincrement())
  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  url       String // hosted on DO Spaces (cover/thumb)
  alt       String?
  isPrimary Boolean @default(false) // card = true, only one per post
  sortOrder Int     @default(0) // sequence 1, 2, 3...

  createdAt DateTime @default(now())

  @@index([postId, sortOrder])
  @@index([postId, isPrimary])
}

// ============================================================
// PEOPLE
// ============================================================

// Job titles shown on the Team section (CEO, manager, sales assistant, ...).
// Managed (created/edited) by admins.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers TeamMember[]
}

model TeamMember {
  id      Int    @id @default(autoincrement())
  name    String
  roleId  Int
  role    Role   @relation(fields: [roleId], references: [id])
  bio     String? @db.Text
  photoUrl String?
  email   String?
  linkedinUrl String?
  sortOrder Int    @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([roleId])
}

// Client/vendor testimonials
model Testimonial {
  id       Int     @id @default(autoincrement())
  author   String
  role     String?
  company  String?
  content  String  @db.Text
  rating   Int? // 1-5
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([isActive])
}

// ============================================================
// ADMIN
// ============================================================

// Single-role auth: every user is "admin".
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String // bcrypt hash
  role         UserRole @default(admin)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiries Inquiry[]
}

// Contact / lead form submissions
model Inquiry {
  id      Int           @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  service String? // which service they asked about
  message String        @db.Text
  status  InquiryStatus @default(new)

  handledById Int?
  handledBy   User? @relation(fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([handledById])
}

// ============================================================
// ENUMS
// ============================================================

enum PostType {
  blog
  vlog
}

enum UserRole {
  admin
}

enum InquiryStatus {
  new
  contacted
  closed
}
